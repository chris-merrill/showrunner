rules_version = '2';
// Showrunner (project showrunner-tools).
// feedback: written only by the API (Admin SDK); the admin reads it at /admin.
// rate/: the API's rate-limit counters, never readable or writable by clients.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /feedback/{id} {
      // Reports arrive only through the API (functions/index.js: Turnstile for
      // the website, install id + rate limit for the extension). No client writes.
      allow create: if false;
      // The admin (a uid listed in admins/, set server-side) reads the inbox and
      // may only change a report's status.
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['new', 'done'];
      allow delete: if false;
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
