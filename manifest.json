{
  "manifest_version": 3,
  "name": "Whatnot Chat Helper",
  "version": "0.6.1",
  "description": "Highlights questions directly in Whatnot live chat and lets you tick them off as you answer.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.whatnot.com/*",
    "https://whatnot.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Whatnot Chat Helper",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.whatnot.com/*",
        "https://whatnot.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
