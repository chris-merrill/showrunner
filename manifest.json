{
  "manifest_version": 3,
  "name": "Showrunner",
  "version": "1.6.1",
  "description": "Seller tools for live shows: live auction status and a DYMO label printed on every sale.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.whatnot.com/*",
    "https://whatnot.com/*",
    "https://127.0.0.1/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://firestore.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Showrunner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.whatnot.com/*",
        "https://whatnot.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png",
        "icons/icon-48.png"
      ],
      "matches": [
        "https://www.whatnot.com/*",
        "https://whatnot.com/*"
      ]
    }
  ]
}
